{
  "name": "gsc-study",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/proxy.test.ts src/lib/test-presentation.test.ts src/components/school/school-sections.test.ts scripts/landing-assets.test.mjs scripts/school-assets.test.mjs",
    "test:proxy": "node --import tsx --test src/proxy.test.ts",
    "test:landing:api": "node --test scripts/landing-api.test.mjs",
    "check:text": "node scripts/check-ai-text.mjs",
    "import:tilda": "tsx scripts/import-tilda-tests.ts",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:deploy": "prisma db push --skip-generate && prisma db execute --file prisma/manual-migrations/20260925_test_contact_fields.sql --schema prisma/schema.prisma && node prisma/seed-if-empty.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-select": "^2.3.8",
    "next": "16.3.8",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "10.4.20",
    "cheerio": "^1.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
