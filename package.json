    "@types/react-dom": "19.0.3",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "10.4.20",
    "cheerio": "^1.2.0",
    "eslint": "9.18.0",
    "eslint-config-next": "^15.5.23",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
